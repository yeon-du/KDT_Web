# Copy this file to .env.local (which .gitignore already excludes from Git)
# and fill in your real EmailJS values from https://dashboard.emailjs.com.
# This example file itself has no real secrets in it, so it's fine to commit.
#
# NEXT_PUBLIC_ prefix is required — Next.js only exposes env vars to
# client-side code (which is all this is, since the site has no server)
# when they start with that prefix.

NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
